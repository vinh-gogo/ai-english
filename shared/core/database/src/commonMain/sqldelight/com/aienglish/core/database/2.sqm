CREATE TABLE IF NOT EXISTS quota (
    quota_id TEXT PRIMARY KEY,
    package_type TEXT NOT NULL CHECK(package_type IN ('day', 'month', 'year')),
    account_type TEXT NOT NULL CHECK(account_type IN ('VIP', 'NORMAL', 'GUEST')),
    is_paid INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS payments (
    payment_id TEXT PRIMARY KEY,
    user_id TEXT NOT NULL,
    amount REAL NOT NULL,
    currency TEXT NOT NULL DEFAULT 'VND',
    status TEXT NOT NULL CHECK(status IN ('PENDING', 'COMPLETED', 'FAILED')),
    payment_method TEXT,
    transaction_ref TEXT,
    created_at INTEGER NOT NULL,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

ALTER TABLE users ADD COLUMN quota_id TEXT REFERENCES quota(quota_id) ON DELETE SET NULL;
