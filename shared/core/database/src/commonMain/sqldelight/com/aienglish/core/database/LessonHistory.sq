CREATE TABLE IF NOT EXISTS lesson_history (
    id INTEGER PRIMARY KEY,
    user_id TEXT NOT NULL DEFAULT '0000000000000000',
    topic TEXT NOT NULL,
    level TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'IN_PROGRESS',
    created_at INTEGER NOT NULL,
    completed_at INTEGER,
    topic_id TEXT,
    FOREIGN KEY(user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS topic_questions (
    id TEXT PRIMARY KEY,
    topic_id TEXT NOT NULL,
    sentence_index INTEGER NOT NULL,
    native_prompt_key TEXT NOT NULL,
    english TEXT NOT NULL,
    explanation_key TEXT,
    UNIQUE(topic_id, sentence_index)
);

CREATE TABLE IF NOT EXISTS question_alternatives (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    question_id TEXT NOT NULL,
    alternative TEXT NOT NULL,
    FOREIGN KEY(question_id) REFERENCES topic_questions(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS question_tokens (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    question_id TEXT NOT NULL,
    word TEXT NOT NULL,
    phonetic TEXT,
    part_of_speech TEXT,
    FOREIGN KEY(question_id) REFERENCES topic_questions(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS grammar_structures (
    id TEXT PRIMARY KEY,
    pattern TEXT NOT NULL UNIQUE,
    meaning_key TEXT NOT NULL,
    explanation_key TEXT NOT NULL,
    example TEXT NOT NULL,
    level TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS grammar_edges (
    id TEXT PRIMARY KEY,
    from_grammar_id TEXT NOT NULL,
    to_grammar_id TEXT NOT NULL,
    edge_type TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    UNIQUE(from_grammar_id, to_grammar_id, edge_type),
    FOREIGN KEY(from_grammar_id) REFERENCES grammar_structures(id) ON DELETE CASCADE,
    FOREIGN KEY(to_grammar_id) REFERENCES grammar_structures(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS question_grammar_map (
    id TEXT PRIMARY KEY,
    question_id TEXT NOT NULL,
    grammar_id TEXT NOT NULL,
    user_custom_note TEXT,
    created_at INTEGER NOT NULL,
    UNIQUE(question_id, grammar_id),
    FOREIGN KEY(question_id) REFERENCES topic_questions(id) ON DELETE CASCADE,
    FOREIGN KEY(grammar_id) REFERENCES grammar_structures(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS lesson_question (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    history_id INTEGER NOT NULL,
    question_id TEXT NOT NULL,
    user_answer TEXT,
    ai_explanation TEXT,
    UNIQUE(history_id, question_id),
    FOREIGN KEY(history_id) REFERENCES lesson_history(id) ON DELETE CASCADE,
    FOREIGN KEY(question_id) REFERENCES topic_questions(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS lesson_feedback (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    history_id INTEGER NOT NULL UNIQUE,
    review TEXT NOT NULL DEFAULT '',
    score INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(history_id) REFERENCES lesson_history(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS question_notes (
    id TEXT PRIMARY KEY,
    question_id INTEGER NOT NULL,
    note TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    UNIQUE(question_id, note),
    FOREIGN KEY(question_id) REFERENCES lesson_question(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS grammar_groups (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,
    created_at INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS grammar_group_node_map (
    group_id TEXT NOT NULL,
    grammar_id TEXT NOT NULL,
    PRIMARY KEY(group_id, grammar_id),
    FOREIGN KEY(group_id) REFERENCES grammar_groups(id) ON DELETE CASCADE,
    FOREIGN KEY(grammar_id) REFERENCES grammar_structures(id) ON DELETE CASCADE
);

-- Queries

insertLesson:
INSERT INTO lesson_history (user_id, topic, level, status, created_at, topic_id)
VALUES (?, ?, ?, 'IN_PROGRESS', ?, ?);

getLastInsertId:
SELECT last_insert_rowid();

updateLessonCompleted:
UPDATE lesson_history
SET status = 'COMPLETED', completed_at = ?
WHERE id = ?;

getAllHistory:
SELECT * FROM lesson_history WHERE user_id = ? ORDER BY created_at DESC;

clearHistory:
DELETE FROM lesson_history;

deleteHistoryByIds:
DELETE FROM lesson_history WHERE id IN ?;

-- Static Questions Queries
insertTopicQuestion:
INSERT OR IGNORE INTO topic_questions (id, topic_id, sentence_index, native_prompt_key, english, explanation_key)
VALUES (?, ?, ?, ?, ?, ?);

insertQuestionAlternative:
INSERT OR IGNORE INTO question_alternatives (question_id, alternative)
VALUES (?, ?);

insertQuestionToken:
INSERT OR IGNORE INTO question_tokens (question_id, word, phonetic, part_of_speech)
VALUES (?, ?, ?, ?);

getStaticQuestionsForTopic:
SELECT * FROM topic_questions WHERE topic_id = ? ORDER BY sentence_index ASC;

getAlternativesForStaticQuestion:
SELECT alternative FROM question_alternatives WHERE question_id = ?;

getTokensForStaticQuestion:
SELECT * FROM question_tokens WHERE question_id = ?;

-- Dynamic Attempt Queries
insertQuestion:
INSERT INTO lesson_question (history_id, question_id, user_answer, ai_explanation)
VALUES (?, ?, ?, ?);

updateQuestionAttempt:
UPDATE lesson_question
SET user_answer = ?, ai_explanation = ?
WHERE id = ?;

getQuestionId:
SELECT q.id 
FROM lesson_question q
INNER JOIN topic_questions t ON q.question_id = t.id
WHERE q.history_id = ? AND t.sentence_index = ?;

getQuestionsForHistory:
SELECT 
    q.id,
    q.history_id,
    t.sentence_index,
    COALESCE(tp.translation_text, t.native_prompt_key) AS vietnamese,
    t.english,
    COALESCE(te.translation_text, t.explanation_key) AS explanation,
    q.user_answer,
    q.ai_explanation,
    t.id AS static_question_id
FROM lesson_question q
INNER JOIN topic_questions t ON q.question_id = t.id
LEFT JOIN i18n_translations tp ON t.native_prompt_key = tp.key_id AND tp.locale_code = 'vi'
LEFT JOIN i18n_translations te ON t.explanation_key = te.key_id AND te.locale_code = 'vi'
WHERE q.history_id = ?
ORDER BY t.sentence_index ASC;

-- Feedback queries
insertOrReplaceFeedback:
INSERT OR REPLACE INTO lesson_feedback (history_id, review, score)
VALUES (?, ?, ?);

getFeedbackForHistory:
SELECT * FROM lesson_feedback WHERE history_id = ?;

-- Notes queries
insertQuestionNote:
INSERT OR IGNORE INTO question_notes (id, question_id, note, created_at)
VALUES (?, ?, ?, ?);

getQuestionNotes:
SELECT * FROM question_notes WHERE question_id = ? ORDER BY created_at DESC;

deleteQuestionNote:
DELETE FROM question_notes WHERE id = ?;

updateQuestionNote:
UPDATE question_notes SET note = ? WHERE id = ?;

getAllHistoryWithCounts:
SELECT
    h.id,
    h.topic,
    h.level,
    h.status,
    h.created_at,
    h.completed_at,
    h.topic_id,
    (SELECT COUNT(*) FROM lesson_question q WHERE q.history_id = h.id) AS total_count,
    (SELECT COUNT(q.ai_explanation) FROM lesson_question q WHERE q.history_id = h.id) AS completed_count
FROM lesson_history h
WHERE h.user_id = ?
ORDER BY h.created_at DESC;

migrateGuestHistory:
UPDATE lesson_history SET user_id = '0000000000000000' WHERE user_id = 'guest';

migrateGuestEmailHistory:
UPDATE lesson_history SET user_id = '0000000000000000' WHERE user_id = 'guest@aienglish.com';

getHistoryTopicId:
SELECT topic_id FROM lesson_history WHERE id = ?;

-- Grammar Graph Queries
getAllGrammarStructures:
SELECT * FROM grammar_structures;

insertGrammarStructure:
INSERT OR REPLACE INTO grammar_structures (id, pattern, meaning_key, explanation_key, example, level, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

getAllGrammarEdges:
SELECT * FROM grammar_edges;

insertGrammarEdge:
INSERT OR REPLACE INTO grammar_edges (id, from_grammar_id, to_grammar_id, edge_type, created_at)
VALUES (?, ?, ?, ?, ?);

getAllSavedQuestionNotes:
SELECT * FROM question_notes;

getAllSavedQuestionNotesWithLevel:
SELECT qn.id, qn.question_id, qn.note, qn.created_at, lh.level
FROM question_notes qn
JOIN lesson_question lq ON qn.question_id = lq.id
JOIN lesson_history lh ON lq.history_id = lh.id;

-- Grammar groups queries
getAllGrammarGroups:
SELECT * FROM grammar_groups ORDER BY created_at ASC;

insertGrammarGroup:
INSERT OR REPLACE INTO grammar_groups (id, name, created_at)
VALUES (?, ?, ?);

updateGrammarGroupName:
UPDATE grammar_groups SET name = :newName WHERE name = :oldName;

deleteGrammarGroup:
DELETE FROM grammar_groups WHERE name = ?;

-- Group node map queries
getNodesForGroupName:
SELECT m.grammar_id 
FROM grammar_group_node_map m
JOIN grammar_groups g ON m.group_id = g.id
WHERE g.name = ?;

insertGroupNodeMapByName:
INSERT OR IGNORE INTO grammar_group_node_map (group_id, grammar_id)
SELECT id, :grammarId FROM grammar_groups WHERE name = :groupName;

deleteGroupNodeMapByName:
DELETE FROM grammar_group_node_map
WHERE grammar_id = :grammarId 
AND group_id = (SELECT id FROM grammar_groups WHERE name = :groupName);
