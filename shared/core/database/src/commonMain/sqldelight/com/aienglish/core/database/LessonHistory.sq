CREATE TABLE IF NOT EXISTS lesson_history (
    id INTEGER PRIMARY KEY,
    user_id TEXT NOT NULL DEFAULT '0000000000000000',
    topic TEXT NOT NULL,
    level TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'IN_PROGRESS',
    created_at INTEGER NOT NULL,
    completed_at INTEGER,
    FOREIGN KEY(user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

insertLesson:
INSERT INTO lesson_history (user_id, topic, level, status, created_at)
VALUES (?, ?, ?, 'IN_PROGRESS', ?);

getLastInsertId:
SELECT last_insert_rowid();

updateLessonCompleted:
UPDATE lesson_history
SET status = 'COMPLETED', completed_at = ?
WHERE id = ?;

getAllHistory:
SELECT * FROM lesson_history WHERE user_id = ? ORDER BY created_at DESC;

clearHistory:
DELETE FROM lesson_history;

deleteHistoryByIds:
DELETE FROM lesson_history WHERE id IN ?;


CREATE TABLE IF NOT EXISTS lesson_question (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    history_id INTEGER NOT NULL,
    sentence_index INTEGER NOT NULL,
    vietnamese TEXT NOT NULL,
    english TEXT NOT NULL,
    explanation TEXT,
    user_answer TEXT,
    ai_explanation TEXT,
    UNIQUE(history_id, sentence_index) ON CONFLICT REPLACE,
    FOREIGN KEY(history_id) REFERENCES lesson_history(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS lesson_question_token (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    question_id INTEGER NOT NULL,
    word TEXT NOT NULL,
    phonetic TEXT,
    part_of_speech TEXT,
    FOREIGN KEY(question_id) REFERENCES lesson_question(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS lesson_feedback (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    history_id INTEGER NOT NULL UNIQUE,
    review TEXT NOT NULL DEFAULT '',
    FOREIGN KEY(history_id) REFERENCES lesson_history(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS question_notes (
    id TEXT PRIMARY KEY,
    question_id INTEGER NOT NULL,
    note TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    UNIQUE(question_id, note),
    FOREIGN KEY(question_id) REFERENCES lesson_question(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS lesson_question_alternative (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    question_id INTEGER NOT NULL,
    alternative TEXT NOT NULL,
    FOREIGN KEY(question_id) REFERENCES lesson_question(id) ON DELETE CASCADE
);

insertQuestion:
INSERT OR REPLACE INTO lesson_question (history_id, sentence_index, vietnamese, english, explanation, user_answer, ai_explanation)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertToken:
INSERT INTO lesson_question_token (question_id, word, phonetic, part_of_speech)
VALUES (?, ?, ?, ?);

deleteTokensForQuestion:
DELETE FROM lesson_question_token WHERE question_id = ?;

insertAlternative:
INSERT INTO lesson_question_alternative (question_id, alternative)
VALUES (?, ?);

getAlternativesForQuestion:
SELECT alternative FROM lesson_question_alternative WHERE question_id = ?;

deleteAlternativesForQuestion:
DELETE FROM lesson_question_alternative WHERE question_id = ?;

getQuestionId:
SELECT id FROM lesson_question WHERE history_id = ? AND sentence_index = ?;

getQuestionsForHistory:
SELECT * FROM lesson_question WHERE history_id = ? ORDER BY sentence_index ASC;

getTokensForQuestion:
SELECT * FROM lesson_question_token WHERE question_id = ?;

insertOrReplaceFeedback:
INSERT OR REPLACE INTO lesson_feedback (history_id, review)
VALUES (?, ?);

getFeedbackForHistory:
SELECT * FROM lesson_feedback WHERE history_id = ?;

insertQuestionNote:
INSERT OR IGNORE INTO question_notes (id, question_id, note, created_at)
VALUES (?, ?, ?, ?);

getQuestionNotes:
SELECT * FROM question_notes WHERE question_id = ? ORDER BY created_at DESC;

deleteQuestionNote:
DELETE FROM question_notes WHERE id = ?;

updateQuestionNote:
UPDATE question_notes SET note = ? WHERE id = ?;

getAllHistoryWithCounts:
SELECT
    h.id,
    h.topic,
    h.level,
    h.status,
    h.created_at,
    h.completed_at,
    (SELECT COUNT(*) FROM lesson_question q WHERE q.history_id = h.id) AS total_count,
    (SELECT COUNT(q.ai_explanation) FROM lesson_question q WHERE q.history_id = h.id) AS completed_count
FROM lesson_history h
WHERE h.user_id = ?
ORDER BY h.created_at DESC;

migrateGuestHistory:
UPDATE lesson_history SET user_id = '0000000000000000' WHERE user_id = 'guest';

migrateGuestEmailHistory:
UPDATE lesson_history SET user_id = '0000000000000000' WHERE user_id = 'guest@aienglish.com';
