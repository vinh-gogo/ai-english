-- 3NF refactored: topic/level denormalized columns removed.
-- topic_id now INTEGER NOT NULL (references learning_topics),
-- system_code references learning_systems,
-- level_code stores raw level code (e.g. 'B1', '500', 'N5').
CREATE TABLE IF NOT EXISTS lesson_history (
    id INTEGER PRIMARY KEY,
    user_id TEXT NOT NULL DEFAULT '0000000000000000',
    system_code TEXT NOT NULL DEFAULT 'CEFR',
    topic_id INTEGER NOT NULL DEFAULT 0,
    level_code TEXT NOT NULL DEFAULT 'B1',
    status TEXT NOT NULL DEFAULT 'IN_PROGRESS',
    created_at INTEGER NOT NULL,
    completed_at INTEGER,
    attempt_count INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(user_id) REFERENCES users(user_id) ON DELETE CASCADE,
    FOREIGN KEY(system_code, topic_id) REFERENCES learning_topics(system_code, topic_id) ON DELETE RESTRICT
);

CREATE TABLE IF NOT EXISTS topic_questions (
    id TEXT PRIMARY KEY,
    topic_id TEXT NOT NULL,
    sentence_index INTEGER NOT NULL,
    native_prompt_key TEXT NOT NULL,
    english TEXT NOT NULL,
    explanation_key TEXT,
    UNIQUE(topic_id, sentence_index)
);

CREATE TABLE IF NOT EXISTS question_alternatives (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    question_id TEXT NOT NULL,
    alternative TEXT NOT NULL,
    FOREIGN KEY(question_id) REFERENCES topic_questions(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS question_tokens (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    question_id TEXT NOT NULL,
    word TEXT NOT NULL,
    phonetic TEXT,
    part_of_speech TEXT,
    FOREIGN KEY(question_id) REFERENCES topic_questions(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS lesson_question (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    history_id INTEGER NOT NULL,
    question_id TEXT NOT NULL,
    user_answer TEXT,
    ai_explanation TEXT,
    UNIQUE(history_id, question_id),
    FOREIGN KEY(history_id) REFERENCES lesson_history(id) ON DELETE CASCADE,
    FOREIGN KEY(question_id) REFERENCES topic_questions(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS lesson_feedback (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    history_id INTEGER NOT NULL UNIQUE,
    review TEXT NOT NULL DEFAULT '',
    score INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(history_id) REFERENCES lesson_history(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS question_notes (
    id TEXT PRIMARY KEY,
    question_id INTEGER NOT NULL,
    note TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    UNIQUE(question_id, note),
    FOREIGN KEY(question_id) REFERENCES lesson_question(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_topic_questions_topic_id ON topic_questions(topic_id);
CREATE INDEX IF NOT EXISTS idx_question_alternatives_question_id ON question_alternatives(question_id);
CREATE INDEX IF NOT EXISTS idx_question_tokens_question_id ON question_tokens(question_id);
CREATE INDEX IF NOT EXISTS idx_lesson_history_user_id ON lesson_history(user_id);
CREATE INDEX IF NOT EXISTS idx_lesson_question_history_id ON lesson_question(history_id);
CREATE INDEX IF NOT EXISTS idx_lesson_question_question_id ON lesson_question(question_id);

-- Queries

insertLesson:
-- 3NF: truyền systemCode, topicId (INTEGER), levelCode thay vì topic/level strings
INSERT INTO lesson_history (user_id, system_code, topic_id, level_code, status, created_at, updated_at)
VALUES (?, ?, ?, ?, 'IN_PROGRESS', ?, ?);

getLastInsertId:
SELECT last_insert_rowid();

updateLessonCompleted:
UPDATE lesson_history
SET status = 'COMPLETED', completed_at = ?, updated_at = ?, attempt_count = attempt_count + 1
WHERE id = ?;

incrementLessonAttempt:
UPDATE lesson_history
SET updated_at = ?, status = 'IN_PROGRESS', completed_at = NULL
WHERE id = ?;

-- 3NF: không update lesson_history.topic nữa, update learning_topics.name cho custom topic
updateCustomTopicName:
UPDATE learning_topics
SET name = ?
WHERE system_code = 'custom' AND topic_id = ?;

-- getAllHistory removed: dùng getAllHistoryWithCounts thay thế (có JOIN với learning_topics)

clearHistory:
DELETE FROM lesson_history;

deleteHistoryByIds:
DELETE FROM lesson_history WHERE id IN ?;

-- Static Questions Queries
insertTopicQuestion:
INSERT OR IGNORE INTO topic_questions (id, topic_id, sentence_index, native_prompt_key, english, explanation_key)
VALUES (?, ?, ?, ?, ?, ?);

insertQuestionAlternative:
INSERT OR IGNORE INTO question_alternatives (question_id, alternative)
VALUES (?, ?);

insertQuestionToken:
INSERT OR IGNORE INTO question_tokens (question_id, word, phonetic, part_of_speech)
VALUES (?, ?, ?, ?);

getStaticQuestionsForTopic:
SELECT * FROM topic_questions WHERE topic_id = ? ORDER BY sentence_index ASC;

getAlternativesForStaticQuestion:
SELECT alternative FROM question_alternatives WHERE question_id = ?;

getTokensForStaticQuestion:
SELECT * FROM question_tokens WHERE question_id = ?;

-- Dynamic Attempt Queries
insertQuestion:
INSERT INTO lesson_question (history_id, question_id, user_answer, ai_explanation)
VALUES (?, ?, ?, ?);

updateQuestionAttempt:
UPDATE lesson_question
SET user_answer = ?, ai_explanation = ?
WHERE id = ?;

resetLessonProgress:
UPDATE lesson_question
SET user_answer = NULL, ai_explanation = NULL
WHERE history_id = ?;

deleteLessonFeedback:
DELETE FROM lesson_feedback
WHERE history_id = ?;

getQuestionId:
SELECT q.id 
FROM lesson_question q
INNER JOIN topic_questions t ON q.question_id = t.id
WHERE q.history_id = ? AND t.sentence_index = ?;

getQuestionsForHistory:
SELECT 
    q.id,
    q.history_id,
    t.sentence_index,
    COALESCE(tp.translation_text, t.native_prompt_key) AS vietnamese,
    t.english,
    COALESCE(te.translation_text, t.explanation_key) AS explanation,
    q.user_answer,
    q.ai_explanation,
    t.id AS static_question_id
FROM lesson_question q
INNER JOIN topic_questions t ON q.question_id = t.id
LEFT JOIN i18n_translations tp ON t.native_prompt_key = tp.key_id AND tp.locale_code = 'vi'
LEFT JOIN i18n_translations te ON t.explanation_key = te.key_id AND te.locale_code = 'vi'
WHERE q.history_id = ?
ORDER BY t.sentence_index ASC;

-- Feedback queries
insertOrReplaceFeedback:
INSERT OR REPLACE INTO lesson_feedback (history_id, review, score)
VALUES (?, ?, ?);

getFeedbackForHistory:
SELECT * FROM lesson_feedback WHERE history_id = ?;

-- Notes queries
insertQuestionNote:
INSERT OR IGNORE INTO question_notes (id, question_id, note, created_at)
VALUES (?, ?, ?, ?);

getQuestionNotes:
SELECT * FROM question_notes WHERE question_id = ? ORDER BY created_at DESC;

deleteQuestionNote:
DELETE FROM question_notes WHERE id = ?;

updateQuestionNote:
UPDATE question_notes SET note = ? WHERE id = ?;

-- 3NF: JOIN với learning_topics để lấy topic name (không còn denormalized topic column)
getAllHistoryWithCounts:
SELECT
    h.id,
    lt.name AS topic,
    h.system_code,
    h.topic_id,
    h.level_code,
    h.status,
    h.created_at,
    h.completed_at,
    h.attempt_count,
    h.updated_at,
    (SELECT COUNT(*) FROM lesson_question q WHERE q.history_id = h.id) AS total_count,
    (SELECT COUNT(q.ai_explanation) FROM lesson_question q WHERE q.history_id = h.id) AS completed_count
FROM lesson_history h
JOIN learning_topics lt ON h.system_code = lt.system_code AND h.topic_id = lt.topic_id
WHERE h.user_id = ?
ORDER BY h.created_at DESC;

migrateGuestHistory:
UPDATE lesson_history SET user_id = '0000000000000000' WHERE user_id = 'guest';

migrateGuestEmailHistory:
UPDATE lesson_history SET user_id = '0000000000000000' WHERE user_id = 'guest@aienglish.com';

-- 3NF: trả về system_code, topic_id và level_code
getHistoryTopicId:
SELECT system_code, topic_id, level_code FROM lesson_history WHERE id = ?;

getAllSavedQuestionNotes:
SELECT * FROM question_notes;
